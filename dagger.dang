type Cryptbox {
  let rust: Rust!
  let postgresVersion: String!

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String!,
    """
    Version (image tag) to use from the official PostgreSQL image repository.
    """
    postgresVersion: String! = "18-trixie",
  ) {
    self.rust = Dagger.rust(ws: ws, version: rustVersion)
    self.postgresVersion = postgresVersion

    self
  }

  """
  Tests and examples from the CI workflow that the Rust module's own checks do not cover.
  """
  test: Test! {
    Test(self.rust.container, self.postgresVersion)
  }
}

"""
Tests and examples from the CI workflow that the Rust module's own checks do not cover.

The Rust module's `test` check runs tests, including doctests, across the feature
matrix configured in Cargo.toml. The explicit all-target test run and runnable
examples live here: the Rust module builds examples, but never runs them.
The PostgreSQL tests need a server,
which GitHub Actions does not provide but Dagger can bind as a service.
"""
type Test {
  let container: Container!
  let postgresVersion: String!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
    """
    Version (image tag) to use from the official PostgreSQL image repository.
    """
    postgresVersion: String!,
  ) {
    self.container = container
    self.postgresVersion = postgresVersion

    self
  }

  """
  Execute all unit and integration tests with every feature enabled.
  """
  allFeatures: Void @check {
    self.run(["cargo", "test", "--locked", "--all-targets", "--all-features"])
  }

  """
  Build the API documentation with every feature enabled, as docs.rs does.
  """
  allFeaturesDoc: Void @check {
    self.run(["cargo", "doc", "--locked", "--no-deps", "--all-features", "-p", "cryptbox", "-p", "cryptbox-derive"])
  }

  """
  Test the derive macros' expansion snapshots, which need cargo-expand.
  """
  derive: Void @check {
    self
      .container
      .withExec(["cargo", "install", "cargo-expand", "--version", "1.0.126", "--locked"])
      .withExec(["cargo", "test", "--locked", "-p", "cryptbox-derive", "--test", "expand", "--", "--ignored"])
      .sync

    null
  }

  """
   Execute SQLx integration and process-level E2E tests against live PostgreSQL.
  """
  postgres: Void @check {
    let server = Dagger
      .container
      .from("postgres:" + self.postgresVersion)
      .withEnvVariable("POSTGRES_USER", "cryptbox")
      .withEnvVariable("POSTGRES_PASSWORD", "cryptbox")
      .withEnvVariable("POSTGRES_DB", "cryptbox")
      .withExposedPort(5432)
      .asService(useEntrypoint: true)

    self
      .container
      .withServiceBinding("postgres", server)
      .withEnvVariable("DATABASE_URL", "postgres://cryptbox:cryptbox@postgres:5432/cryptbox")
      .withExec([
        "cargo", "test", "--locked",
        "--test", "sqlx_postgres",
        "--test", "migrate_sqlx_postgres",
        "--test", "e2e",
        "--no-default-features", "--features", "migrate,sqlx-postgres",
        "--", "--include-ignored",
      ])
      .sync

    null
  }

  """
  Fuzz the stored-format parsers for a minute per target; see fuzz/README.md.
  """
  fuzz: Void @check {
    let container = self
      .container
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "--yes", "--no-install-recommends", "g++"])
      .withExec(["rustup", "toolchain", "install", "nightly", "--profile", "minimal"])
      .withExec(["cargo", "install", "cargo-fuzz", "--version", "0.13.2", "--locked"])

    let targets = ["envelope_parse", "envelope_round_trip", "blind_index_parse", "blind_index_round_trip"]

    targets.each { target =>
      container = container.withExec([
        "cargo", "+nightly", "fuzz", "run", target, "--", "-max_total_time=60",
      ])
    }

    container.sync

    null
  }

  """
  Run the key rotation example.
  """
  keyRotation: Void @check {
    self.example("key_rotation", feature: ["derive"])
  }

  """
  Run the re-encryption sweep example.
  """
  reencryptionSweep: Void @check {
    self.example("reencryption_sweep", feature: ["derive", "sqlx-sqlite"])
  }

  """
  Run the plaintext migration example.
  """
  plaintextMigration: Void @check {
    self.example("plaintext_migration", feature: ["derive", "migrate", "sqlx-sqlite"])
  }

  """
  Run the legacy migration example.
  """
  legacyMigration: Void @check {
    self.example("legacy_migration", feature: ["derive", "migrate", "sqlx-sqlite"])
  }

  """
  Run the blind indexes example.
  """
  blindIndexes: Void @check {
    self.example("blind_indexes", feature: ["derive"])
  }

  """
  Run the SQLx SQLite example.
  """
  sqlxSqlite: Void @check {
    self.example("sqlx_sqlite", feature: ["derive", "sqlx-sqlite"])
  }

  """
  Run the explicit Serde stored-value example.
  """
  storedValues: Void @check {
    self.example("stored_values", feature: ["derive", "serde"])
  }

  let example(
    """
    Name of the example target to run.
    """
    name: String!,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
  ): Void {
    let args = ["cargo", "run", "--locked", "--example", name]

    feature.each { f => args += ["--features", f] }

    self.run(args)
  }

  let run(args: [String!]!): Void {
    self.container.withExec(args).sync

    null
  }
}
