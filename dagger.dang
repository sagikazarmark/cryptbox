type Cryptbox {
  let rust: Rust!
  let postgresVersion: String!

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String!,
    """
    Version (image tag) to use from the official PostgreSQL image repository.
    """
    postgresVersion: String! = "18-trixie",
  ) {
    self.rust = Dagger.rust(ws: ws, version: rustVersion)
    self.postgresVersion = postgresVersion

    self
  }

  """
  Tests and examples from the CI workflow that the Rust module's own checks do not cover.
  """
  test: Test! {
    Test(self.rust.container, self.postgresVersion)
  }

  """
  Deterministic documentation checks and an explicit network link check.
  """
  docs: Docs! {
    Docs(self.rust.container)
  }
}

"""
Documentation checks shared with GitHub Actions through repository scripts.
"""
type Docs {
  let container: Container!

  new(container: Container!) {
    self.container = container
    self
  }

  """
  Build default and all-feature API docs with warnings denied.
  """
  rustdoc: String! @check {
    self.container.withExec(["sh", "scripts/check-rustdoc.sh"]).combinedOutput
  }

  """
  Check shared snippets and run isolated consumers against checkout and release.
  """
  consumers: String! @check {
    self.container
      .withExec(["sh", "-c", "apt-get update && apt-get install -y --no-install-recommends nodejs"])
      .withExec(["node", "scripts/doc-snippets.mjs"])
      .withExec(["node", "scripts/check-consumers.mjs", "checkout"])
      .withExec(["node", "scripts/check-consumers.mjs", "published"])
      .combinedOutput
  }

  """
  Re-render the canonical Mermaid diagram and compare the committed rustdoc SVG.
  """
  diagrams: String! @check {
    Dagger.container
      .from("ghcr.io/mermaid-js/mermaid-cli/mermaid-cli:11.12.0@sha256:bad64c9d9ad917c8dfbe9d9e9c162b96f6615ff019b37058638d16eb27ce7783")
      .withDirectory("/data", self.container.directory("."))
      .withWorkdir("/data")
      .withExec(["sh", "scripts/check-diagrams.sh"])
      .combinedOutput
  }

  """
  Check local Markdown paths and fragments without network access.
  """
  localLinks: String! @check {
    self.links("local")
  }

  """
  Check external URLs and fragments. Explicit/scheduled only, not a PR check.
  """
  externalLinks: String! {
    self.links("external")
  }

  let links(mode: String!): String! {
    Dagger.container
      .from("lycheeverse/lychee:0.24.2")
      .withDirectory("/work", self.container.directory("."))
      .withWorkdir("/work")
      .withExec(["sh", "scripts/check-links.sh", mode])
      .combinedOutput
  }
}

"""
Tests and examples from the CI workflow that the Rust module's own checks do not cover.

The Rust module's `test` check compiles and runs the test targets with default features
only, so the all-feature and documentation test runs live here, as do the examples: the
Rust module builds them, but never runs them. The PostgreSQL tests need a server,
which GitHub Actions does not provide but Dagger can bind as a service.
"""
type Test {
  let container: Container!
  let postgresVersion: String!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
    """
    Version (image tag) to use from the official PostgreSQL image repository.
    """
    postgresVersion: String!,
  ) {
    self.container = container
    self.postgresVersion = postgresVersion

    self
  }

  """
  Execute all unit and integration tests with every feature enabled.
  """
  allFeatures: String! @check {
    self.run(["cargo", "test", "--locked", "--all-targets", "--all-features"])
  }

  """
  Execute the documentation tests with every feature enabled.
  """
  doc: String! @check {
    self.run(["cargo", "test", "--locked", "--doc", "--all-features"])
  }

  """
  Check each SQLx backend independently, with and without migration support.
  """
  sqlxFeatures: String! @check {
    self.run(["sh", "scripts/check-sqlx-features.sh"])
  }

  """
   Execute SQLx tests and the durable consumer against live PostgreSQL.
  """
  postgres: String! @check {
    let server = Dagger
      .container
      .from("postgres:" + self.postgresVersion)
      .withEnvVariable("POSTGRES_USER", "cryptbox")
      .withEnvVariable("POSTGRES_PASSWORD", "cryptbox")
      .withEnvVariable("POSTGRES_DB", "cryptbox")
      .withExposedPort(5432)
      .asService(useEntrypoint: true)

    self
      .container
      .withServiceBinding("postgres", server)
      .withEnvVariable("DATABASE_URL", "postgres://cryptbox:cryptbox@postgres:5432/cryptbox")
      .withExec(["sh", "-c", "apt-get update && apt-get install -y --no-install-recommends nodejs"])
      .withExec(["node", "scripts/check-searchable-consumer.mjs", "checkout", "postgres"])
      .withExec(["node", "scripts/check-searchable-consumer.mjs", "published", "postgres"])
      .withExec([
        "cargo", "test", "--locked",
        "--test", "sqlx_postgres",
        "--test", "migrate_sqlx_postgres",
        "--no-default-features", "--features", "migrate,sqlx-postgres",
        "--", "--include-ignored",
      ])
      .combinedOutput
  }

  """
  Run the key rotation example.
  """
  keyRotation: String! @check {
    self.example("key_rotation")
  }

  """
  Run the re-encryption sweep example.
  """
  reencryptionSweep: String! @check {
    self.example("reencryption_sweep", feature: ["sqlx-sqlite"])
  }

  """
  Run the plaintext migration example.
  """
  plaintextMigration: String! @check {
    self.example("plaintext_migration", feature: ["migrate", "sqlx-sqlite"])
  }

  """
  Run the legacy migration example.
  """
  legacyMigration: String! @check {
    self.example("legacy_migration", feature: ["migrate", "sqlx-sqlite"])
  }

  """
  Run the blind indexes example.
  """
  blindIndexes: String! @check {
    self.example("blind_indexes")
  }

  """
  Run the SQLx SQLite example.
  """
  sqlxSqlite: String! @check {
    self.example("sqlx_sqlite", feature: ["sqlx-sqlite"])
  }

  """
  Run the explicit Serde stored-value example.
  """
  storedValues: String! @check {
    self.example("stored_values", feature: ["serde"])
  }

  let example(
    """
    Name of the example target to run.
    """
    name: String!,
    """
    List of features to activate.
    """
    feature: [String!]! = [],
  ): String! {
    let args = ["cargo", "run", "--locked", "--example", name]

    feature.each { f => args += ["--features", f] }

    self.run(args)
  }

  let run(args: [String!]!): String! {
    self.container.withExec(args).combinedOutput
  }
}
